# Copia este archivo a .env.local para desarrollo (vercel dev) y define los valores reales
# en Vercel → Project → Settings → Environment Variables. Nunca subas valores reales a Git.

# Clave API de Resend (https://resend.com/api-keys). Permiso: "Sending access".
RESEND_API_KEY=

# Remitente autorizado en Resend. Requiere el dominio ayscorp.online verificado en Resend.
# Ejemplo: Cuadra <formularios@ayscorp.online>
CONTACT_FROM=

# Orígenes permitidos para enviar el formulario (separados por comas).
ALLOWED_ORIGINS=https://www.ayscorp.online,https://ayscorp.online

# "true" para aceptar envíos desde despliegues de vista previa *.vercel.app
ALLOW_VERCEL_PREVIEWS=false
